PORT=3000
NODE_ENV=development

# Conexión al servidor MySQL (VitaNexo) y base de datos existente VitaBase
# Ajuste MYSQL_HOST y MYSQL_PORT según el servidor donde esté alojada VitaBase
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=vitanexo_app
MYSQL_PASSWORD=cambiar_por_contrasena_real
MYSQL_DATABASE=VitaBase

# Opciones del pool de conexiones
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT_MS=5000

# Seguridad HTTP, CORS y Autenticación Corporativa
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
AUTH_TOKEN_SECRET=generar_secreto_hmac_local_64_caracteres
AUTH_TOKEN_TTL_HOURS=12
AUTH_ACCESS_CODE=VitaNexoCR2026

# Integración con n8n Local (Webhooks autenticados hacia Gemini API)
N8N_BASE_URL=http://127.0.0.1:5678
N8N_WEBHOOK_SECRET=generar_secreto_webhook_local_compartido_con_n8n
N8N_TIMEOUT_MS=45000
N8N_MAX_RETRIES=2
N8N_RATE_LIMIT_PER_MINUTE=30

# Configuración de Gemini API (la clave reside cifrada en n8n o opcionalmente aquí en backend; NUNCA en frontend)
GEMINI_MODEL=models/gemini-3-flash-preview
GEMINI_API_KEY=
