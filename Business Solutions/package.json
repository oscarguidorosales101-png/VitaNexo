{
  "name": "vitanexo-backend",
  "version": "1.0.0",
  "description": "Backend REST API, lógica de negocio, métricas SQL y orquestador de agentes deterministas para VitaNexo (Costa Rica) conectado a MySQL VitaBase.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:inspect": "node scripts/inspect-db.js",
    "db:migrate": "node scripts/migrate-db.js",
    "db:seed": "node scripts/seed-db.js",
    "db:metrics": "node scripts/run-metrics.js",
    "test": "jest --runInBand --verbose",
    "test:unit": "jest tests/unit tests/http --runInBand --verbose",
    "test:db": "jest tests/integration --runInBand --verbose",
    "n8n:build": "node n8n/scripts/build-workflows.js",
    "n8n:import": "node n8n/scripts/import-workflows.js",
    "n8n:export": "node n8n/scripts/export-workflows.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}

